<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Миний захиалгууд</h1>
    <p class="mt-2 text-sm text-gray-600">Таны идэвхтэй болон хүчингүй болсон захиалгуудын жагсаалт</p>
  </div>

  <% if @subscriptions.any? %>
    <!-- Subscriptions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @subscriptions.each do |subscription| %>
        <% plan = subscription.subscription_plan %>
        <% sellable = plan.sellable %>
        
        <div class="bg-white rounded-lg shadow-sm border <%= subscription.active? ? 'border-green-500' : 'border-gray-200' %> overflow-hidden">
          <!-- Status Badge -->
          <div class="px-6 pt-6 pb-4 border-b border-gray-200">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-gray-900">
                <%= sellable.name %>
              </h3>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium <%= subscription.active? ? 'bg-green-100 text-green-800' : subscription.cancelled? ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>">
                <%= subscription.active? ? 'Идэвхтэй' : subscription.cancelled? ? 'Цуцлагдсан' : 'Түр зогссон' %>
              </span>
            </div>
            
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-bold text-gray-900">
                <%= number_to_currency(plan.price, unit: "₮", precision: 0, format: "%n%u") %>
              </span>
              <span class="text-sm text-gray-600">
                /<%= plan.monthly? ? 'сар' : 'жил' %>
              </span>
            </div>
          </div>

          <!-- Subscription Details -->
          <div class="px-6 py-4">
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between">
                <dt class="text-gray-600">Эхэлсэн огноо:</dt>
                <dd class="text-gray-900 font-medium"><%= subscription.start_date.strftime('%Y-%m-%d') %></dd>
              </div>
              
              <% if subscription.end_date.present? %>
                <div class="flex justify-between">
                  <dt class="text-gray-600">Дууссан огноо:</dt>
                  <dd class="text-gray-900 font-medium"><%= subscription.end_date.strftime('%Y-%m-%d') %></dd>
                </div>
              <% end %>
              
              <div class="flex justify-between">
                <dt class="text-gray-600">Төлбөрийн давтамж:</dt>
                <dd class="text-gray-900 font-medium"><%= plan.monthly? ? 'Сар бүр' : 'Жил бүр' %></dd>
              </div>
              
              <% if plan.trial_days > 0 %>
                <div class="flex justify-between">
                  <dt class="text-gray-600">Туршилтын хугацаа:</dt>
                  <dd class="text-gray-900 font-medium"><%= plan.trial_days %> хоног</dd>
                </div>
              <% end %>
            </dl>
          </div>

          <!-- Actions -->
          <% if subscription.active? %>
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200">
              <%= button_to "Цуцлах", cancel_subscription_path(subscription), 
                method: :patch,
                data: { turbo_confirm: "Та итгэлтэй байна уу?" },
                class: "w-full px-4 py-2 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-lg hover:bg-red-50 transition-colors" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-8 flex justify-center">
      <%= will_paginate @subscriptions, 
        class: "flex space-x-2",
        inner_window: 2,
        outer_window: 0,
        previous_label: "← Өмнөх",
        next_label: "Дараах →"
      %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="text-center py-12 bg-white rounded-lg border border-gray-200">
      <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <h3 class="mt-4 text-lg font-medium text-gray-900">Захиалга олдсонгүй</h3>
      <p class="mt-2 text-sm text-gray-500">Та одоогоор ямар нэгэн захиалгатай үйлчилгээ авч байхгүй байна.</p>
      <div class="mt-6">
        <%= link_to "Үйлчилгээ харах", services_path, class: "inline-flex items-center px-6 py-3 bg-[#0053E2] hover:bg-[#003299] text-white font-semibold rounded-lg transition-colors" %>
      </div>
    </div>
  <% end %>
</div>

<!-- Tailwind Pagination Styles -->
<style>
  .pagination {
    display: flex;
    gap: 0.5rem;
    list-style: none;
  }
  .pagination a, .pagination span {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    border: 1px solid transparent;
    min-width: 3rem;
    text-align: center;
    display: inline-block;
  }
  .pagination a {
    color: #4B5563;
    text-decoration: none;
    background-color: white;
    border-color: #E5E7EB;
  }
  .pagination a:hover {
    background-color: #F9FAFB;
    border-color: #0053E2;
    color: #0053E2;
    transform: translateY(-1px);
  }
  .pagination .current {
    background: linear-gradient(135deg, #0053E2 0%, #003299 100%);
    color: white;
    font-weight: 600;
    border-color: #0053E2;
    box-shadow: 0 4px 12px rgba(0, 83, 226, 0.3);
  }
  .pagination .disabled {
    color: #D1D5DB;
    cursor: not-allowed;
    background-color: #F9FAFB;
    border-color: #E5E7EB;
  }
</style>
