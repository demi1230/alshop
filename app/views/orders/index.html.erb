<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Миний захиалгууд</h1>
    <p class="text-gray-600">Таны хийсэн бүх захиалгуудын жагсаалт</p>
  </div>

  <% if @orders.empty? %>
    <div class="bg-white rounded-lg shadow-lg p-12 text-center">
      <%= heroicon('shopping-bag', class: 'w-16 h-16 text-gray-300 mx-auto mb-4') %>
      <h2 class="text-xl font-semibold text-gray-700 mb-2">Захиалга байхгүй байна</h2>
      <p class="text-gray-500 mb-6">Та одоогоор ямар ч захиалга хийгээгүй байна</p>
      <%= link_to "Дэлгүүр үзэх", root_path, class: "inline-block px-6 py-3 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition" %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <div class="bg-white rounded-lg shadow hover:shadow-lg transition p-6">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">
                Захиалга #<%= order.id %>
              </h3>
              <p class="text-sm text-gray-500">
                <%= l(order.created_at, format: :long) %>
              </p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold <%= status_badge_class(order.status) %>">
              <%= t("order.status.#{order.status}") %>
            </span>
          </div>

          <div class="flex justify-between items-center border-t pt-4">
            <div>
              <p class="text-sm text-gray-500">Нийт дүн</p>
              <p class="text-xl font-bold text-gray-900">
                <%= number_to_currency(order.total_price, unit: "₮", format: "%n %u") %>
              </p>
            </div>
            <div class="flex gap-2">
              <%= link_to "Дэлгэрэнгүй", order_path(order), class: "px-4 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-8">
      <%= will_paginate @orders, 
          class: 'flex justify-center gap-2',
          inner_window: 2,
          outer_window: 0,
          previous_label: '← Өмнөх',
          next_label: 'Дараах →' %>
    </div>
  <% end %>
</div>

<% content_for :head do %>
  <style>
    <%= render 'status_badge_styles' %>
  </style>
<% end %>
