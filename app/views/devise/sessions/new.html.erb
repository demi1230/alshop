<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
  <div class="max-w-md w-full">
    <!-- Logo/Title -->
    <div class="text-center mb-8">
      <%= link_to root_path, class: "inline-block" do %>
        <h1 class="text-4xl font-bold text-[#0053E2]">AlShop</h1>
      <% end %>
      <p class="mt-2 text-gray-600">Таны хэрэгцээт бүтээгдэхүүн</p>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-2xl shadow-xl p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Нэвтрэх</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
        <!-- Email Field -->
        <div class="mb-6">
          <%= f.label :email, "И-мэйл хаяг", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.email_field :email, 
            autofocus: true, 
            autocomplete: "email",
            class: "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#0053E2] focus:border-transparent transition-all",
            placeholder: "example@email.com" %>
        </div>

        <!-- Password Field -->
        <div class="mb-6">
          <div class="flex items-center justify-between mb-2">
            <%= f.label :password, "Нууц үг", class: "block text-sm font-semibold text-gray-700" %>
            <%= link_to "Мартсан уу?", new_password_path(resource_name), class: "text-sm text-[#0053E2] hover:text-[#003299]" %>
          </div>
          <%= f.password_field :password, 
            autocomplete: "current-password",
            class: "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#0053E2] focus:border-transparent transition-all",
            placeholder: "••••••••" %>
        </div>

        <!-- Remember Me -->
        <% if devise_mapping.rememberable? %>
          <div class="mb-6">
            <label class="flex items-center">
              <%= f.check_box :remember_me, class: "w-4 h-4 text-[#0053E2] border-gray-300 rounded focus:ring-[#0053E2]" %>
              <span class="ml-2 text-sm text-gray-700">Намайг сана</span>
            </label>
          </div>
        <% end %>

        <!-- Submit Button -->
        <div class="mb-6">
          <%= f.submit "Нэвтрэх", 
            class: "w-full bg-[#0053E2] hover:bg-[#003299] active:bg-[#001E60] text-white font-bold py-3 px-6 rounded-lg transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <!-- Links -->
      <div class="text-center">
        <p class="text-sm text-gray-600">
          Бүртгэлгүй юу? 
          <%= link_to "Бүртгүүлэх", new_registration_path(resource_name), class: "font-semibold text-[#0053E2] hover:text-[#003299]" %>
        </p>
      </div>
    </div>

    <!-- Footer Links -->
    <div class="mt-6 text-center">
      <%= link_to "← Нүүр хуудас руу буцах", root_path, class: "text-sm text-gray-600 hover:text-[#0053E2]" %>
    </div>
  </div>
</div>
