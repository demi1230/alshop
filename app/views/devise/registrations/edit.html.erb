<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-6">
      <h1 class="text-2xl font-semibold text-[#0053E2]">Хувийн мэдээлэл засах</h1>
      <p class="text-gray-500 text-sm mt-1">Та өөрийн мэдээллээ энд засч болно</p>
    </div>

    <!-- Main Form Card -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Email Field -->
        <div>
          <%= f.label :email, "Имэйл хаяг", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email, 
              autofocus: true, 
              autocomplete: "email",
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2] focus:border-transparent" %>
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="mt-2 text-sm text-orange-600">
              <%= resource.unconfirmed_email %> хаягийг баталгаажуулахыг хүлээж байна
            </p>
          <% end %>
        </div>

        <div class="border-t border-gray-200 pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Нууц үг солих</h3>
          <p class="text-sm text-gray-500 mb-4">Нууц үгээ солихгүй бол хоосон үлдээнэ үү</p>

          <!-- New Password -->
          <div class="mb-4">
            <%= f.label :password, "Шинэ нууц үг", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.password_field :password, 
                autocomplete: "new-password",
                placeholder: "Хоосон үлдээхэд нууц үг солигдохгүй",
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2] focus:border-transparent" %>
            <% if @minimum_password_length %>
              <p class="mt-1 text-sm text-gray-500">
                Хамгийн багадаа <%= @minimum_password_length %> тэмдэгт байх ёстой
              </p>
            <% end %>
          </div>

          <!-- Password Confirmation -->
          <div>
            <%= f.label :password_confirmation, "Шинэ нууц үг дахин", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.password_field :password_confirmation, 
                autocomplete: "new-password",
                placeholder: "Нууц үгээ дахин оруулна уу",
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2] focus:border-transparent" %>
          </div>
        </div>

        <div class="border-t border-gray-200 pt-6">
          <!-- Current Password -->
          <div>
            <%= f.label :current_password, "Одоогийн нууц үг", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.password_field :current_password, 
                autocomplete: "current-password",
                required: true,
                placeholder: "Өөрчлөлтийг баталгаажуулахын тулд одоогийн нууц үгээ оруулна уу",
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2] focus:border-transparent" %>
            <p class="mt-1 text-sm text-gray-500">
              Аюулгүй байдлын үүднээс одоогийн нууц үгээ оруулна уу
            </p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center justify-between pt-6">
          <%= link_to :back, class: "inline-flex items-center gap-2 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Буцах
          <% end %>
          
          <%= f.submit "Хадгалах", class: "inline-flex items-center gap-2 bg-[#0053E2] text-white font-medium px-6 py-2 rounded-lg hover:bg-[#004CC9] transition-colors shadow cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <!-- Danger Zone -->
    <div class="bg-white rounded-lg shadow-sm border-2 border-red-200 p-6">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Бүртгэл устгах</h3>
          <p class="text-sm text-gray-600 mb-4">
            Таны бүртгэлийг устгасны дараа буцаах боломжгүй болно. Энэ үйлдэл нь таны бүх мэдээллийг устгана.
          </p>
          <%= button_to registration_path(resource_name), 
              data: { confirm: "Та итгэлтэй байна уу? Энэ үйлдлийг буцаах боломжгүй!", turbo_confirm: "Та итгэлтэй байна уу?" }, 
              method: :delete,
              class: "inline-flex items-center gap-2 bg-red-600 text-white font-medium px-4 py-2 rounded-lg hover:bg-red-700 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            Бүртгэл устгах
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
