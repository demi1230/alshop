<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]">Төлөвлөгөө нэмэх</h1>
      <p class="text-gray-500 text-sm mt-1"><%= @service.name %></p>
    </div>
    <%= link_to edit_admin_service_path(@service), class: "inline-flex items-center gap-2 text-gray-700 font-medium hover:text-gray-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Буцах
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: [:admin, @service, @subscription_plan], local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <%= f.label :name, "Төлөвлөгөөний нэр", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :name, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]", required: true, placeholder: "Basic, Pro, Enterprise..." %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :description, "Тайлбар", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :description, rows: 3, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]", placeholder: "Энэ төлөвлөгөөний давуу тал..." %>
        </div>

        <div>
          <%= f.label :price, "Үнэ (₮)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :price, step: 0.01, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]", required: true %>
        </div>

        <div>
          <%= f.label :billing_cycle, "Төлбөрийн мөчлөг", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :billing_cycle,
              options_for_select([
                ['Сар бүр', 'monthly'],
                ['Улирал бүр', 'quarterly'],
                ['Жил бүр', 'yearly']
              ], @subscription_plan.billing_cycle),
              {},
              class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]",
              required: true %>
        </div>

        <div>
          <%= f.label :trial_days, "Туршилтын өдөр", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :trial_days, value: @subscription_plan.trial_days || 0, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
          <p class="text-xs text-gray-500 mt-1">0 бол туршилтгүй</p>
        </div>

        <div>
          <%= f.label :is_featured, "Онцлох эсэх", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="flex items-center gap-3 h-[50px]">
            <%= f.check_box :is_featured, class: "w-6 h-6 text-gray-900 rounded focus:ring-[#0053E2]" %>
            <span class="text-sm font-semibold text-gray-700">Онцлох төлөвлөгөө</span>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-4 border-t">
        <%= link_to "Цуцлах", edit_admin_service_path(@service), class: "px-2 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
        <%= f.submit "Хадгалах", class: "px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
