<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]">Брэндүүд</h1>
      <p class="text-gray-500 text-sm mt-1">Brands</p>
    </div>
    <%= link_to "Шинэ брэнд нэмэх", new_admin_brand_path, class: "px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors" %>
  </div>

  <!-- Search & Actions -->
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: admin_brands_path, method: :get, local: true, class: "flex gap-4" do |f| %>
      <div class="flex-1">
        <%= f.text_field :q, value: params[:q], placeholder: "Брэндийн нэрээр хайх...", class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
      </div>
      <div class="flex gap-2">
        <%= link_to "Цэвэрлэх", admin_brands_path, class: "px-2 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium" %>
        <%= f.submit "Хайх", class: "px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Brands Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @brands.any? %>
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase">Нэр</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase">Вэбсайт</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase">Бүтээгдэхүүн</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase">Үйлдэл</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @brands.each do |brand| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <div class="font-medium text-gray-700"><%= brand.name %></div>
              </td>
              <td class="px-6 py-4">
                <% if brand.website_url.present? %>
                  <%= link_to brand.website_url, brand.website_url, target: "_blank", class: "text-[#0053E2] hover:underline text-sm" %>
                <% else %>
                  <span class="text-gray-500 text-sm">-</span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <span class="px-3 py-1.5 bg-blue-50 text-[#0053E2] rounded-full text-sm font-medium">
                  <%= brand.products.count %>
                </span>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center justify-center gap-2">
                  <%= link_to edit_admin_brand_path(brand), class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-[#0053E2] hover:bg-blue-50 transition-colors" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  <% end %>
                  <%= link_to admin_brand_path(brand), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Та итгэлтэй байна уу?" }, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-red-600 hover:bg-red-50 transition-colors" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-12 text-center">
        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
        <p class="text-gray-500 font-bold text-lg">Брэнд олдсонгүй</p>
        <% if params[:q].present? %>
          <p class="text-sm text-gray-500 mt-2">
            Хайлтын нөхцөлд тохирох брэнд байхгүй байна.
            <%= link_to "Хайлт цэвэрлэх", admin_brands_path, class: "text-gray-900 hover:underline font-bold" %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if @brands.any? %>
    <div class="flex justify-center mt-6">
      <%= will_paginate @brands, 
          previous_label: '← Өмнөх', 
          next_label: 'Дараах →',
          class: 'pagination',
          inner_window: 2,
          outer_window: 1 %>
    </div>
  <% end %>
</div>
