<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]">Тохиргоо засах</h1>
      <p class="text-gray-500 text-sm mt-1"><%= @service.name %></p>
    </div>
    <%= link_to edit_admin_service_path(@service), class: "inline-flex items-center gap-2 text-gray-700 font-medium hover:text-gray-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Буцах
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <% if @service_config_spec.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
        <h3 class="text-sm font-semibold text-red-800 mb-2">Алдаа гарлаа:</h3>
        <ul class="list-disc list-inside text-sm text-red-700">
          <% @service_config_spec.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [:admin, @service, @service_config_spec], local: true, data: { turbo: false }, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <%= f.label :field_name, "Талбарын нэр", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :field_name, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]", required: true %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :description, "Тайлбар", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :description, rows: 3, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
        </div>

        <div>
          <%= f.label :data_type, "Өгөгдлийн төрөл", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :data_type,
              options_for_select([
                ['Text', 'string'],
                ['Number', 'integer'],
                ['Date', 'date'],
                ['Checkbox', 'boolean'],
                ['Options', 'option']
              ], @service_config_spec.data_type),
              {},
              class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]",
              required: true,
              id: "data-type-select",
              onchange: "toggleOptionsSection()" %>
        </div>

        <div>
          <%= f.label :unit_price, "Нэгж үнэ (₮)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :unit_price, step: 0.01, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
        </div>

        <div class="md:col-span-2" id="options-section">
          <div class="flex items-center justify-between mb-2">
            <%= f.label :options, "Сонголтууд (Options)", class: "block text-sm font-medium text-gray-700" %>
            <button type="button" onclick="addOptionField()" class="px-3 py-1 bg-green-500 hover:bg-green-600 text-white text-sm font-medium rounded-lg transition-colors">
              + Сонголт нэмэх
            </button>
          </div>
          <div id="options-container" class="space-y-2">
            <!-- Existing options will be loaded here -->
          </div>
          <p class="text-xs text-gray-500 mt-2">Зөвхөн "Options" төрөлд ашиглана</p>
        </div>

        <div>
          <%= f.label :default_value, "Анхдагч утга", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :default_value, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
        </div>

        <div>
          <%= f.label :required, "Шаардлагатай эсэх", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="flex items-center gap-3 h-[50px]">
            <%= f.check_box :required, class: "w-6 h-6 text-gray-900 rounded focus:ring-[#0053E2]" %>
            <span class="text-sm font-semibold text-gray-700">Заавал бөглөх</span>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-4 border-t">
        <%= link_to "Цуцлах", edit_admin_service_path(@service), class: "px-2 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
        <%= f.submit "Шинэчлэх", class: "px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

<script>
(function() {
  let optionIndex = 0;

  window.toggleOptionsSection = function() {
    const dataType = document.getElementById('data-type-select').value;
    const optionsSection = document.getElementById('options-section');
    const optionInputs = document.querySelectorAll('[name="option_values[]"]');
    
    if (dataType === 'option') {
      optionsSection.style.display = 'block';
      optionInputs.forEach(input => input.required = true);
    } else {
      optionsSection.style.display = 'none';
      optionInputs.forEach(input => input.required = false);
    }
  };

  window.addOptionField = function(value = '', price = 0) {
    const container = document.getElementById('options-container');
    const optionHtml = `
      <div class="option-field flex gap-2 items-start p-3 border border-gray-200 rounded-lg bg-gray-50">
        <div class="flex-1">
          <input type="text" 
                 name="option_values[]" 
                 value="${value}"
                 placeholder="Сонголтын нэр (жнь: Basic, Premium)" 
                 class="w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]"
                 required>
        </div>
        <div class="w-40">
          <input type="number" 
                 name="option_prices[]" 
                 step="0.01"
                 value="${price}"
                 placeholder="Үнэ (₮)" 
                 class="w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]">
        </div>
        <button type="button" 
                onclick="this.closest('.option-field').remove()" 
                class="px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors">
          ✕
        </button>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', optionHtml);
    optionIndex++;
  };

  // Load existing options
  function initialize() {
    const container = document.getElementById('options-container');
    if (!container) return;
    
    // Clear existing options to prevent duplication on turbo:load
    container.innerHTML = '';
    
    const existingOptions = <%= raw @service_config_spec.options.presence || '[]' %>;
    
    if (existingOptions.length > 0) {
      existingOptions.forEach(option => {
        window.addOptionField(option.value, option.price);
      });
    } else {
      window.addOptionField();
    }
    
    window.toggleOptionsSection();
  }

  document.addEventListener('turbo:load', initialize);
  document.addEventListener('DOMContentLoaded', initialize);
})();
</script>
