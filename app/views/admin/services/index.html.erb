<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]">Үйлчилгээнүүд</h1>
      <p class="text-gray-500 text-sm mt-1">Services Management</p>
    </div>
    <%= link_to new_admin_service_path, class: "inline-flex items-center gap-2 px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Шинэ үйлчилгээ
    <% end %>
  </div>

  <!-- Search & Filters -->
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: admin_services_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Search -->
        <div>
          <%= f.label :q, "Хайх", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :q, value: params[:q], placeholder: "Үйлчилгээний нэрээр хайх...", class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
        </div>

        <!-- Category Filter -->
        <div>
          <%= f.label :category_id, "Ангилал", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :category_id, 
              options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
              { include_blank: "Бүгд" },
              class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
        </div>

        <!-- Service Type Filter -->
        <div>
          <%= f.label :service_type, "Үйлчилгээний төрөл", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :service_type,
              options_for_select([
                ['Бүгд', ''],
                ['Цагийн', 'hourly'],
                ['Тогтмол', 'fixed'],
                ['Захиалгат', 'subscription']
              ], params[:service_type]),
              {},
              class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
        </div>

        <!-- Status Filter -->
        <div>
          <%= f.label :status, "Төлөв", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status,
              options_for_select([
                ['Бүгд', ''],
                ['Идэвхтэй', 'active'],
                ['Идэвхгүй', 'inactive']
              ], params[:status]),
              {},
              class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
        </div>
      </div>

      <div class="flex gap-2">
        <%= f.submit "Хайх", class: "px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors cursor-pointer" %>
        <%= link_to "Цэвэрлэх", admin_services_path, class: "px-2 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
      </div>
    <% end %>
  </div>

  <!-- Bulk Actions -->
  <%= form_with url: bulk_action_admin_services_path, method: :post, local: true, id: "bulk-form" do |f| %>
    <div class="bg-white rounded-lg shadow mb-6 p-4 flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <label class="flex items-center">
          <input type="checkbox" id="select-all" class="rounded border-gray-300 text-[#0053E2] focus:ring-[#0053E2]">
          <span class="ml-2 text-sm text-gray-700">Бүгдийг сонгох</span>
        </label>
        <span class="text-sm text-gray-500" id="selected-count">0 сонгосон</span>
      </div>
      
      <div class="flex space-x-2">
        <%= f.select :action, 
            options_for_select([
              ['Үйлдэл сонгох', ''],
              ['Идэвхжүүлэх', 'activate'],
              ['Идэвхгүй болгох', 'deactivate'],
              ['Устгах', 'delete']
            ]),
            {},
            class: "px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]",
            id: "bulk-action-select" %>
        <%= f.submit "Хэрэгжүүлэх", class: "bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-4 rounded", id: "bulk-submit", disabled: true %>
      </div>
    </div>

    <!-- Services Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left">
              <input type="checkbox" id="select-all" class="w-4 h-4 text-gray-900 rounded focus:ring-[#0053E2]">
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Үйлчилгээ</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Ангилал</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Үндсэн үнэ</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Төлөв</th>
            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-900 uppercase tracking-wider">Үйлдлүүд</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% if @services.any? %>
            <% @services.each do |service| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4">
                  <%= check_box_tag "service_ids[]", service.id, false, class: "service-checkbox w-4 h-4 text-gray-900 rounded focus:ring-[#0053E2]" %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-gray-50 rounded-lg flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                    <div>
                      <div class="font-medium text-gray-900"><%= service.name %></div>
                      <div class="text-sm text-gray-500 line-clamp-1"><%= service.sellable.description&.truncate(50) %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm font-semibold text-gray-700"><%= service.category&.name || '-' %></span>
                </td>
                <td class="px-6 py-4">
                  <span class="font-medium text-gray-900">₮<%= number_with_delimiter(service.base_price.to_i) %></span>
                </td>
                <td class="px-6 py-4">
                  <% if service.is_active %>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Идэвхтэй
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Идэвхгүй
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to edit_admin_service_path(service), class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-[#0053E2] hover:bg-blue-50 transition-colors", title: "Засах" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    <% end %>
                    <%= button_to toggle_active_admin_service_path(service), method: :patch, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg #{service.is_active ? 'text-yellow-600 hover:bg-yellow-50' : 'text-green-600 hover:bg-green-50'} transition-colors", title: service.is_active ? "Идэвхгүй болгох" : "Идэвхжүүлэх" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                    <% end %>
                    <%= button_to admin_service_path(service), method: :delete, data: { confirm: 'Устгахдаа итгэлтэй байна уу?' }, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-red-600 hover:bg-red-50 transition-colors", title: "Устгах" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center">
                <div class="flex flex-col items-center justify-center">
                  <div class="w-16 h-16 bg-gray-50 rounded-lg flex items-center justify-center mb-4">
                    <svg class="w-8 h-8 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <p class="text-gray-500 font-semibold">Үйлчилгээ олдсонгүй</p>
                  <% if params[:q].present? || params[:category_id].present? || params[:service_type].present? || params[:status].present? %>
                    <%= link_to "Шүүлтийг цэвэрлэх", admin_services_path, class: "mt-4 text-gray-900 font-medium hover:underline" %>
                  <% else %>
                    <%= link_to "Эхний үйлчилгээгээ нэмэх", new_admin_service_path, class: "mt-4 text-gray-900 font-medium hover:underline" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @services.any? %>
    <div class="flex items-center justify-between">
      <div class="text-sm text-gray-700 font-medium">
        Нийт <%= @services.offset + 1 %>-<%= [@services.offset + @services.length, @services.total_entries].min %>-ийг <%= @services.total_entries %>-с харуулж байна
      </div>
      <div class="flex gap-2">
        <%= will_paginate @services, 
            previous_label: '← Өмнөх', 
            next_label: 'Дараах →',
            inner_window: 2,
            outer_window: 1,
            class: 'flex gap-2',
            page_links: true,
            container: false %>
      </div>
    </div>
  <% end %>
</div>

<style>
  .pagination a, .pagination .current, .pagination .gap {
    @apply px-4 py-2 rounded-lg font-bold transition-colors;
  }
  .pagination a {
    @apply bg-white text-gray-900 border border-gray-300 hover:bg-gray-50;
  }
  .pagination .current {
    @apply bg-[#0053E2] text-white;
  }
  .pagination .gap {
    @apply bg-transparent text-gray-500;
