<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]">Бүтээгдэхүүн</h1>
      <p class="text-gray-500 text-sm mt-1">Бүтээгдэхүүн удирдах</p>
    </div>
    <%= link_to new_admin_product_path, class: "inline-flex items-center gap-2 bg-[#0053E2] text-white font-medium px-4 py-2 rounded-lg hover:bg-[#004CC9] transition-colors shadow hover:shadow" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Шинэ бүтээгдэхүүн
    <% end %>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: admin_products_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4" do |f| %>
      <!-- Search -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Хайлт</label>
        <%= f.text_field :q, value: params[:q], placeholder: "Хайлт...", class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2] focus:border-transparent" %>
      </div>

      <!-- Category Filter -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Ангилал</label>
        <%= f.select :category_id, 
            options_for_select([['All Categories', '']] + Category.where.not(id: Category.joins(:children).select(:id)).pluck(:name, :id), params[:category_id]),
            {},
            class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2] focus:border-transparent" %>
      </div>

      <!-- Brand Filter -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Брэнд</label>
        <%= f.select :brand_id,
            options_for_select([['Бүх брэнд', '']] + Brand.pluck(:name, :id), params[:brand_id]),
            {},
            class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2] focus:border-transparent" %>
      </div>

      <!-- Status Filter -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Төлөв</label>
        <%= f.select :status,
            options_for_select([['Бүгд', ''], ['Идэвхтэй', 'active'], ['Идэвхгүй', 'inactive']], params[:status]),
            {},
            class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2] focus:border-transparent" %>
      </div>

      <!-- Filter Buttons -->
      <div class="md:col-span-4 flex gap-3">
        <%= f.submit "Хайх", class: "bg-[#0053E2] text-white font-medium px-2 py-2 rounded-lg hover:bg-[#004CC9] transition-colors cursor-pointer" %>
        <%= link_to "Цэвэрлэх", admin_products_path, class: " px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
      </div>
    <% end %>
  </div>

  <!-- Bulk Actions (shown when items selected) -->
  <%= form_with url: bulk_update_admin_products_path, method: :patch, local: true, id: "bulk-form", data: { controller: "admin--table" } do %>
    <div id="bulk-actions-bar" data-admin--table-target="bulkActions" class="hidden bg-gray-50 border border-blue-600 rounded-lg p-4 mb-4">
      <div class="flex items-center justify-between">
        <span class="text-gray-900 font-bold">
          <span data-count>0</span> items selected
        </span>
        <div class="flex gap-3">
          <button type="submit" name="bulk_action" value="activate" class="bg-green-600 text-white font-medium px-2 py-2 rounded-lg hover:bg-green-700 transition-colors text-sm">
            Activate
          </button>
          <button type="submit" name="bulk_action" value="deactivate" class="bg-yellow-600 text-white font-medium px-2 py-2 rounded-lg hover:bg-yellow-700 transition-colors text-sm">
            Deactivate
          </button>
          <button type="submit" name="bulk_action" value="delete" onclick="return confirm('Are you sure?')" class="bg-red-600 text-white font-medium px-2 py-2 rounded-lg hover:bg-red-700 transition-colors text-sm">
            Delete
          </button>
        </div>
      </div>
    </div>

    <!-- Products Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left">
              <input type="checkbox" data-action="change->admin--table#toggleAll" data-admin--table-target="selectAll" class="w-4 h-4 text-gray-900 rounded focus:ring-[#0053E2]">
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Product</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Category</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Brand</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Price</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Status</th>
            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-900 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% if @products.any? %>
            <% @products.each do |product| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4">
                  <%= check_box_tag 'product_ids[]', product.id, false, 
                      data: { 
                        action: "change->admin--table#toggleRow",
                        admin__table_target: "checkbox"
                      },
                      class: "w-4 h-4 text-gray-900 rounded focus:ring-[#0053E2]" %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-gray-50 rounded-lg flex items-center justify-center flex-shrink-0">
                      <%= heroicon('cube', class: 'w-6 h-6 text-gray-900') %>
                    </div>
                    <div>
                      <div class="font-medium text-gray-900"><%= product.name %></div>
                      <div class="text-sm text-gray-500 line-clamp-1"><%= product.sellable.description&.truncate(50) %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm font-semibold text-gray-700"><%= product.category&.name || '-' %></span>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm font-semibold text-gray-700"><%= product.brand&.name || '-' %></span>
                </td>
                <td class="px-6 py-4">
                  <span class="font-medium text-gray-900">₮<%= number_with_delimiter(product.base_price) %></span>
                </td>
                <td class="px-6 py-4">
                  <% if product.is_active %>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Active
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Inactive
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to edit_admin_product_path(product), class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-[#0053E2] hover:bg-blue-50 transition-colors", title: "Засах" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    <% end %>
                    <%= button_to toggle_active_admin_product_path(product), method: :patch, remote: true, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg #{product.is_active ? 'text-yellow-600 hover:bg-yellow-50' : 'text-green-600 hover:bg-green-50'} transition-colors", title: product.is_active ? "Идэвхгүй болгох" : "Идэвхжүүлэх" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                    <% end %>
                    <%= button_to admin_product_path(product), method: :delete, data: { confirm: 'Устгахдаа итгэлтэй байна уу?' }, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-red-600 hover:bg-red-50 transition-colors", title: "Устгах" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-6 py-12 text-center">
                <div class="flex flex-col items-center justify-center">
                  <div class="w-16 h-16 bg-gray-50 rounded-lg flex items-center justify-center mb-4">
                    <%= heroicon('cube', class: 'w-8 h-8 text-gray-900') %>
                  </div>
                  <p class="text-gray-500 font-semibold">No products found</p>
                  <%= link_to "Add your first product", new_admin_product_path, class: "mt-4 text-gray-900 font-medium hover:underline" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @products.any? %>
    <div class="flex items-center justify-between">
      <div class="text-sm text-gray-700 font-medium">
        Showing <%= @products.offset + 1 %>-<%= [@products.offset + @products.length, @products.total_entries].min %> of <%= @products.total_entries %> products
      </div>
      <div class="flex gap-2">
        <%= will_paginate @products, 
            previous_label: '← Previous', 
            next_label: 'Next →',
            inner_window: 2,
            outer_window: 1,
            class: 'flex gap-2',
            page_links: true,
            container: false,
            renderer: WillPaginate::ActionView::LinkRenderer.new %>
      </div>
    </div>
  <% end %>
</div>

<style>
  .pagination a, .pagination .current, .pagination .gap {
    @apply px-4 py-2 rounded-lg font-bold transition-colors;
  }
  .pagination a {
    @apply bg-white text-gray-900 border border-gray-300 hover:bg-gray-50;
  }
  .pagination .current {
    @apply bg-[#0053E2] text-white;
  }
  .pagination .gap {
    @apply bg-transparent text-gray-500;
  }
</style>
