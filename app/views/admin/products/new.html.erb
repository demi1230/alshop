<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-lg font-semibold text-[#0053E2]">Шинэ бүтээгдэхүүн</h1>
      <p class="text-gray-500 text-sm mt-1">Create New Product</p>
    </div>
    <%= link_to admin_products_path, class: "inline-flex items-center gap-2 text-gray-700 font-medium hover:text-gray-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Products
    <% end %>
  </div>

  <!-- 1️⃣ Product Info Card -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-[#0053E2] mb-4 flex items-center gap-2">
      <%= heroicon('cube', class: 'w-6 h-6') %>
      Product Info
    </h2>
    
    <%= form_with model: [:admin, @product], local: true, class: "space-y-4" do |f| %>
      <%= f.fields_for :sellable_attributes, @product.sellable do |sellable_fields| %>
        <%= sellable_fields.hidden_field :sellable_type, value: 'Product' %>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Name -->
          <div class="md:col-span-2">
            <%= sellable_fields.label :name, "Бүтээгдэхүүний нэр", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= sellable_fields.text_field :name, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
          </div>

          <!-- Description -->
          <div class="md:col-span-2">
            <%= sellable_fields.label :description, "Тайлбар", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= sellable_fields.text_area :description, rows: 4, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
          </div>

          <!-- Category -->
          <div>
            <%= f.label :category_id, "Ангилал", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :category_id,
                hierarchical_category_options(@categories, @product.category_id),
                { prompt: 'Ангилал сонгох' },
                class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
            <p class="text-sm text-gray-500 mt-1"> Зөвхөн дэд ангилалгүй (leaf) ангиллыг сонгох боломжтой</p>
          </div>

          <!-- Brand -->
          <div>
            <%= f.label :brand_id, "Брэнд", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :brand_id,
                options_for_select(@brands.map { |b| [b.name, b.id] }, @product.brand_id),
                { prompt: 'Брэнд сонгох' },
                class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
          </div>

          <!-- Base Price -->
          <div>
            <%= sellable_fields.label :base_price, "Үндсэн үнэ (₮)", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= sellable_fields.number_field :base_price, step: 0.01, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
          </div>

          <!-- Initial Stock -->
          <div>
            <%= f.label :initial_stock, "Анхны үлдэгдэл", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.number_field :initial_stock, value: 0, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
            <p class="text-sm text-gray-500 mt-1">Хувилбаргүй бүтээгдэхүүний үлдэгдэл</p>
          </div>

          <!-- Status -->
          <div class="md:col-span-2">
            <%= sellable_fields.label :is_active, "Төлөв", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="flex items-center gap-3">
              <%= sellable_fields.check_box :is_active, class: "w-6 h-6 text-gray-900 rounded focus:ring-[#0053E2]" %>
              <span class="text-sm font-semibold text-gray-700">Идэвхтэй</span>
            </div>
          </div>
        </div>
      <% end %>

      <div class="flex justify-end pt-4 border-t">
        <%= f.submit "Бүтээгдэхүүн үүсгэх", class: "px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- 2️⃣ Specifications Card -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-[#0053E2] mb-4 flex items-center gap-2">
      <%= heroicon('document-text', class: 'w-6 h-6') %>
      Specifications
    </h2>
    
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <p class="text-sm text-blue-800">
         Бүтээгдэхүүн үүсгэсний дараа specification талбарууд автоматаар харагдана.
      </p>
    </div>
  </div>

  <!-- 3️⃣ Variant Dimensions Card -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-[#0053E2] mb-4 flex items-center gap-2">
      <%= heroicon('squares-2x2', class: 'w-6 h-6') %>
      Variant Dimensions
    </h2>
    
    <p class="text-sm text-gray-500 mb-4">
      Бүтээгдэхүүний хэмжээсийг (жнь: Хэмжээ, Өнгө) болон тэдгээрийн утгуудыг тодорхойлно уу. Эдгээрийг ашиглан variant хослол үүсгэгдэнэ.
    </p>

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <p class="text-sm text-blue-800">
         Variant dimensions нь бүтээгдэхүүн үүсгэсний дараа тохируулах боломжтой. Эхлээд Product Info-г хадгална уу.
      </p>
    </div>
  </div>

  <!-- 4️⃣ Variant Combinations -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-[#0053E2] mb-4 flex items-center gap-2">
      <%= heroicon('cube-transparent', class: 'w-6 h-6') %>
      Variant Combinations
    </h2>

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <p class="text-sm text-blue-800">
         Бүтээгдэхүүн үүсгэсний дараа variant dimensions тодорхойлж, combinations үүсгэх боломжтой болно.
      </p>
    </div>
  </div>

  <!-- 5️⃣ Pricing Rules -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-[#0053E2] mb-4 flex items-center gap-2">
      <%= heroicon('currency-dollar', class: 'w-6 h-6') %>
      Pricing Rules
    </h2>

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <p class="text-sm text-blue-800">
         Үнийн дүрэм нь бүтээгдэхүүн үүсгэсний дараа тохируулах боломжтой. Эхлээд Product Info-г хадгална уу.
      </p>
    </div>
  </div>
</div>
