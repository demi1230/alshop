    <!-- Mobile close button -->
    <button type="button" 
            class="lg:hidden text-gray-400 hover:text-white"
            data-action="click->admin--sidebar#close">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  
  <!-- Navigation -->
  <nav class="flex-1 px-3 py-4 overflow-y-auto">
    <div class="space-y-1">
      <!-- Home/Overview -->
      <%= nav_link 'Admin Home', admin_root_path, icon: 'chart-bar' %>
      
      <!-- Catalog Section -->
      <div class="pt-4">
        <div class="px-3 mb-2 text-xs font-semibold text-[#FFC220] uppercase tracking-wider">
          Catalog
        </div>
        <%= nav_link 'Products', admin_products_path, icon: 'cube' %>
        <%= nav_link 'Services', admin_services_path, icon: 'briefcase' %>
        <%= nav_link 'Categories', admin_categories_path, icon: 'folder' %>
        <%= nav_link 'Brands', admin_brands_path, icon: 'tag' %>
      </div>
      
      <!-- Pricing Section -->
      <div class="pt-4">
        <div class="px-3 mb-2 text-xs font-semibold text-[#FFC220] uppercase tracking-wider">
          Pricing
        </div>
        <%= nav_link 'Pricing Rules', admin_pricing_rules_path, icon: 'calculator' %>
        <%= nav_link 'Discounts', admin_discounts_path, icon: 'receipt-percent' %>
      </div>
    </div>
  </nav>
  
  <!-- User info -->
  <div class="border-t border-[#003299] p-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-[#FFC220] rounded-full flex items-center justify-center shadow">
        <span class="text-[#0053E2] font-black text-lg">
          <%= current_user.email.first.upcase %>
        </span>
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-semibold truncate">
          <%= current_user.email %>
        </div>
        <div class="text-xs text-[#E9F1FE] font-medium">
          Administrator
        </div>
      </div>
    </div>
    <%= link_to 'Sign Out', destroy_user_session_path, 
          data: { turbo_method: :delete },
          class: "mt-3 flex items-center justify-center gap-2 w-full px-6 py-2.5 text-sm font-medium text-[#0053E2] bg-[#FFC220] rounded-lg hover:bg-[#D6A72C] transition-colors shadow" %>
  </div>
</aside>
