<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]"><%= @category.name %></h1>
      <p class="text-gray-500 text-sm mt-1">Edit Category</p>
    </div>
    <%= link_to admin_categories_path, class: "inline-flex items-center gap-2 text-gray-700 font-medium hover:text-gray-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Буцах
    <% end %>
  </div>

  <!-- 1️⃣ Category Info -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-[#0053E2] mb-4 flex items-center gap-2">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
      </svg>
      Ангиллын мэдээлэл
    </h2>

    <%= form_with model: [:admin, @category], local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Category Name -->
        <div class="md:col-span-2">
          <%= f.label :name, "Ангиллын нэр", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :name, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]", required: true %>
        </div>

        <!-- Parent Category -->
        <div class="md:col-span-2">
          <%= f.label :parent_id, "Эцэг ангилал (заавал биш)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :parent_id,
              hierarchical_category_options(@parent_categories, @category.parent_id),
              { include_blank: 'Эцэг ангилал сонгох (үндсэн ангилал бол хоосон үлдээнэ үү)' },
              class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
          <p class="text-sm text-gray-500 mt-1">Өөрийн дэд ангиллыг эцэг ангилал болгож болохгүй</p>
        </div>
      </div>

      <div class="flex justify-end pt-4 border-t">
        <%= f.submit "Мэдээлэл хадгалах", class: "px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- 2️⃣ Category Attributes -->
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-[#0053E2] flex items-center gap-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        Тодорхойлолт
        <span class="text-sm font-normal text-gray-500 ml-2">(Category Attributes)</span>
      </h2>
      <%= link_to "Шинэ тодорхойлолт нэмэх", new_admin_category_category_attribute_path(@category), class: "px-2 py-2 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors text-sm" %>
    </div>

    <% if @category.category_attributes.any? %>
      <div class="space-y-3">
        <% @category.category_attributes.each do |attr| %>
          <div class="p-4 border-2 border-gray-200 rounded-lg bg-gray-50 flex items-center justify-between">
            <div class="flex-1">
              <h3 class="font-medium text-gray-700 text-lg"><%= attr.name %></h3>
              <div class="flex gap-4 mt-1 text-sm text-gray-500">
                <span><strong>Нэгж:</strong> <%= attr.unit.present? ? attr.unit : 'Байхгүй' %></span>
                <span><strong>Заавал:</strong> <%= attr.is_required? ? 'Тийм' : '❌ Үгүй' %></span>
              </div>
            </div>
            <div class="flex gap-2">
              <%= link_to "Засах", edit_admin_category_category_attribute_path(@category, attr), class: "px-2 py-2 text-sm text-[#0053E2] hover:text-[#004CC9] font-medium" %>
              <%= link_to "Устгах", admin_category_category_attribute_path(@category, attr), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Итгэлтэй байна уу?" }, class: "px-2 py-2 text-sm text-red-600 hover:text-red-800 font-medium" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 text-gray-500 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
        <svg class="w-12 h-12 mx-auto text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <p class="font-bold text-lg">Тодорхойлолт байхгүй</p>
        <p class="text-sm mt-2">Энэ ангилалд бүтээгдэхүүн/үйлчилгээний тодорхойлолт нэмэгдээгүй байна</p>
      </div>
    <% end %>
  </div>

  <!-- Info Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Statistics -->
    <div class="bg-gradient-to-r from-purple-50 to-purple-100 border-2 border-purple-300 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-purple-900 mb-3">Статистик</h3>
      <div class="space-y-2 text-purple-800 font-semibold">
        <div class="flex justify-between">
          <span>Бүтээгдэхүүн:</span>
          <span class="font-semibold"><%= @category.products.count %></span>
        </div>
        <div class="flex justify-between">
          <span>Үйлчилгээ:</span>
          <span class="font-semibold"><%= @category.services.count %></span>
        </div>
        <div class="flex justify-between">
          <span>Дэд ангилал:</span>
          <span class="font-semibold"><%= @category.children.count %></span>
        </div>
        <div class="flex justify-between">
          <span>Тодорхойлолт:</span>
          <span class="font-semibold"><%= @category.category_attributes.count %></span>
        </div>
      </div>
    </div>

    <!-- Warnings -->
    <div class="bg-gradient-to-r from-yellow-50 to-yellow-100 border-2 border-yellow-300 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-yellow-900 mb-3">Анхаарах зүйлс</h3>
      <ul class="text-yellow-800 text-sm font-medium space-y-2 list-disc list-inside">
        <li>Дэд ангилал бүхий ангилалд бүтээгдэхүүн нэмэх боломжгүй</li>
        <li>Бүтээгдэхүүн бүхий ангилалыг устгах боломжгүй</li>
        <li>Тодорхойлолт нь энэ ангиллын бүх бүтээгдэхүүнд хамаарна</li>
      </ul>
    </div>
  </div>
</div>
