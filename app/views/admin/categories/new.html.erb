<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]">Шинэ ангилал</h1>
      <p class="text-gray-500 text-sm mt-1">Create New Category</p>
    </div>
    <%= link_to admin_categories_path, class: "inline-flex items-center gap-2 text-gray-700 font-medium hover:text-gray-900 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Буцах
    <% end %>
  </div>

  <!-- Category Form -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-[#0053E2] mb-4 flex items-center gap-2">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
      </svg>
      Ангиллын мэдээлэл
    </h2>

    <%= form_with model: [:admin, @category], local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Category Name -->
        <div class="md:col-span-2">
          <%= f.label :name, "Ангиллын нэр", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :name, class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]", placeholder: "жнь: Электроникс, Хувцас, Хүнсний бүтээгдэхүүн...", required: true %>
        </div>

        <!-- Parent Category -->
        <div class="md:col-span-2">
          <%= f.label :parent_id, "Эцэг ангилал (заавал биш)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :parent_id,
              hierarchical_category_options(@parent_categories, @category.parent_id),
              { prompt: 'Эцэг ангилал сонгох (үндсэн ангилал бол хоосон үлдээнэ үү)' },
              class: "w-full px-2 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0053E2]" %>
          <p class="text-sm text-gray-500 mt-1">Хэрэв эцэг ангилал сонгохгүй бол үндсэн (root) ангилал үүснэ</p>
        </div>
      </div>

      <div class="flex justify-end pt-4 border-t">
        <%= f.submit "Ангилал үүсгэх", class: "px-2 py-2 bg-[#0053E2] text-white font-medium rounded-lg hover:bg-[#004CC9] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Info Card -->
  <div class="bg-blue-50 border-2 border-blue-300 rounded-lg p-6">
    <div class="flex items-start gap-4">
      <div class="bg-[#0053E2] rounded-full p-3">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div class="flex-1">
        <h3 class="text-lg font-semibold text-blue-900 mb-2">ℹ️ Анхаарах зүйлс</h3>
        <ul class="text-blue-800 text-sm font-medium leading-relaxed space-y-1 list-disc list-inside">
          <li>Ангилал үүсгэсний дараа тодорхойлолт (Category Attributes) нэмж болно</li>
          <li>Зөвхөн дэд ангилалгүй (leaf) ангилалд бүтээгдэхүүн/үйлчилгээ хамааруулах боломжтой</li>
          <li>Олон түвшний иерархи үүсгэж болно (жнь: Электроникс Гар утас iPhone)</li>
        </ul>
      </div>
    </div>
  </div>
</div>
