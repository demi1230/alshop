<tr class="hover:bg-gray-50">
  <td class="px-6 py-4">
    <div class="flex items-center gap-2">
      <%= '　' * level %>
      <% if category.children.any? %>
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
        </svg>
      <% end %>
      <span class="text-sm font-semibold text-gray-700"><%= category.name %></span>
    </div>
  </td>
  <td class="px-6 py-4">
    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium 
      <%= category.category_type == 'product' ? 'bg-blue-50 text-[#0053E2]' : 
          category.category_type == 'service' ? 'bg-green-100 text-green-800' : 
          'bg-purple-100 text-purple-800' %>">
      <%= category.category_type.titleize %>
    </span>
  </td>
  <td class="px-6 py-4">
    <div class="flex items-center gap-2">
      <span class="text-sm text-gray-500"><%= category.category_attributes.count %> attributes</span>
      <%= link_to admin_category_category_attributes_path(category), class: "px-2 py-2 text-sm text-[#0053E2] hover:text-[#004CC9] font-medium rounded-lg" do %>
        Manage →
      <% end %>
    </div>
  </td>
  <td class="px-6 py-4">
    <div class="flex items-center gap-2">
      <%= link_to edit_admin_category_path(category), class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-[#0053E2] hover:bg-blue-50 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
      <% end %>
      <%= button_to admin_category_path(category), method: :delete, 
          data: { turbo_confirm: 'Та энэ ангиллыг устгахдаа итгэлтэй байна уу?' },
          class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-red-600 hover:bg-red-50 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
      <% end %>
    </div>
  </td>
</tr>

<% category.children.each do |child| %>
  <%= render 'category_row', category: child, level: level + 1 %>
<% end %>
