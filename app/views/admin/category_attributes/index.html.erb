<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]"><%= @category.name %> - Attributes</h1>
      <p class="text-gray-500 font-medium mt-1">Энэ category-н бүтээгдэхүүнд ашиглагдах техникийн мэдээлэл</p>
    </div>
    <div class="flex gap-3">
      <%= link_to admin_categories_path, class: "inline-flex items-center gap-2 text-gray-700 font-bold hover:text-[#0053E2] transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Categories
      <% end %>
      <%= link_to new_admin_category_category_attribute_path(@category), class: "inline-flex items-center gap-2 px-6 py-3 bg-[#0053E2] text-white font-bold rounded-lg hover:bg-[#003299] transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add Attribute
      <% end %>
    </div>
  </div>

  <!-- Attributes List -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @category_attributes.any? %>
      <table class="w-full">
        <thead class="bg-[#E9F1FE]">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-semibold text-[#0053E2] uppercase">Attribute Name</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-[#0053E2] uppercase">Required</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-[#0053E2] uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @category_attributes.each do |attr| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <div class="text-sm font-semibold text-gray-700"><%= attr.name %></div>
              </td>
              <td class="px-6 py-4">
                <% if attr.is_required %>
                  <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    Required
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    Optional
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <%= link_to edit_admin_category_category_attribute_path(@category, attr), class: "px-2 py-2 text-sm text-[#0053E2] hover:text-[#004CC9] font-medium rounded-lg" do %>
                    Edit
                  <% end %>
                  <%= button_to admin_category_category_attribute_path(@category, attr), method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: "px-2 py-2 text-sm text-red-600 hover:text-red-800 font-medium rounded-lg" do %>
                    Delete
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-gray-500 font-semibold">No attributes defined yet</p>
        <p class="text-sm text-gray-500 mt-2">Add attributes to define technical specifications for products in this category</p>
      </div>
    <% end %>
  </div>

  <!-- Info Box -->
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
    <h3 class="text-sm font-semibold text-blue-900 mb-2">💡 What are Category Attributes?</h3>
    <p class="text-sm text-blue-800">
      Category attributes define what technical information products in this category should have.
      <br>
      <strong>Examples:</strong>
      <br>
      • Electronics: CPU, RAM, Screen Size, Battery
      <br>
      • Clothing: Material, Size Guide, Care Instructions
      <br>
      • Books: Author, Publisher, ISBN, Page Count
    </p>
  </div>
</div>
