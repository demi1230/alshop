<div class="space-y-6 max-w-2xl mx-auto">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-[#0053E2]">New Attribute</h1>
      <p class="text-gray-500 font-medium mt-1"><%= @category.name %></p>
    </div>
    <%= link_to admin_category_category_attributes_path(@category), class: "inline-flex items-center gap-2 text-gray-700 font-bold hover:text-[#0053E2] transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Attributes
    <% end %>
  </div>

  <!-- Form -->
  <div class="bg-white rounded-lg shadow p-8">
    <%= form_with model: [:admin, @category, @category_attribute], local: true, class: "space-y-6" do |f| %>
      <!-- Error Messages -->
      <% if @category_attribute.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <h3 class="text-red-800 font-bold mb-2"><%= pluralize(@category_attribute.errors.count, "error") %> prohibited this attribute from being saved:</h3>
          <ul class="list-disc list-inside text-red-700 text-sm">
            <% @category_attribute.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Attribute Name -->
      <div>
        <%= f.label :name, "Attribute Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.text_field :name, class: "w-full px-4 py-3 border border-gray-300 rounded-[8px] focus:outline-none focus:ring-2 focus:ring-[#0053E2]", placeholder: "e.g., CPU, Material, Screen Size" %>
        <p class="text-xs text-gray-500 mt-1">The name of the technical specification</p>
      </div>

      <!-- Is Required -->
      <div>
        <%= f.label :is_required, "Is this attribute required?", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <div class="flex items-center gap-3">
          <label class="inline-flex items-center">
            <%= f.radio_button :is_required, true, class: "w-4 h-4 text-[#0053E2]" %>
            <span class="ml-2 text-sm font-semibold text-gray-700">Required</span>
          </label>
          <label class="inline-flex items-center">
            <%= f.radio_button :is_required, false, checked: true, class: "w-4 h-4 text-[#0053E2]" %>
            <span class="ml-2 text-sm font-semibold text-gray-700">Optional</span>
          </label>
        </div>
      </div>

      <!-- Submit -->
      <div class="flex justify-end gap-3 pt-4 border-t">
        <%= link_to "Cancel", admin_category_category_attributes_path(@category), class: "px-6 py-3 bg-gray-100 text-gray-700 font-bold rounded-lg hover:bg-gray-200 transition-colors" %>
        <%= f.submit "Create Attribute", class: "px-6 py-3 bg-[#0053E2] text-white font-bold rounded-lg hover:bg-[#003299] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
