<% content_for :title, 'Dashboard' %>

<div class="space-y-6">
  <!-- Page header -->
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-[#0053E2]">Dashboard</h1>
    <div class="text-sm text-gray-500 font-normal">
      <%= l(Date.current, format: :long) %>
    </div>
  </div>
  
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Revenue Card -->
    <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="text-sm font-medium text-gray-700">Total Revenue</div>
        <div class="w-10 h-10 bg-[#0053E2] rounded-lg flex items-center justify-center shadow">
          <%= heroicon('currency-dollar', class: 'w-6 h-6 text-white') %>
        </div>
      </div>
      <div class="text-3xl font-bold text-[#0053E2] mb-2">
        <%= format_currency(@this_month_revenue) %>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <% if @revenue_growth >= 0 %>
          <span class="text-green-600 font-semibold flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.293 7.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L6.707 7.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <%= format_percentage(@revenue_growth) %>
          </span>
        <% else %>
          <span class="text-red-600 font-semibold flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M14.707 12.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 14.586V3a1 1 0 012 0v11.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <%= format_percentage(@revenue_growth.abs) %>
          </span>
        <% end %>
        <span class="text-gray-500 font-normal">from last month</span>
      </div>
    </div>
    
    <!-- Orders Card -->
    <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="text-sm font-medium text-gray-700">Orders</div>
        <div class="w-10 h-10 bg-[#FFC220] rounded-lg flex items-center justify-center shadow">
          <%= heroicon('shopping-cart', class: 'w-6 h-6 text-[#0053E2]') %>
        </div>
      </div>
      <div class="text-2xl font-semibold text-[#0053E2] mb-2">
        <%= @this_month_orders %>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <% if @orders_growth >= 0 %>
          <span class="text-green-600 font-bold">+<%= format_percentage(@orders_growth) %></span>
        <% else %>
          <span class="text-red-600 font-bold"><%= format_percentage(@orders_growth) %></span>
        <% end %>
        <span class="text-gray-500 font-medium">this month</span>
      </div>
    </div>
    
    <!-- Products Card -->
    <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="text-sm font-semibold text-gray-700">Products</div>
        <div class="w-10 h-10 bg-[#0053E2] rounded-lg flex items-center justify-center shadow">
          <%= heroicon('cube', class: 'w-6 h-6 text-white') %>
        </div>
      </div>
      <div class="text-2xl font-semibold text-[#0053E2] mb-2">
        <%= @active_products %>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <span class="text-gray-700 font-bold"><%= @total_products %></span>
        <span class="text-gray-500 font-medium">total products</span>
      </div>
    </div>
    
    <!-- Customers Card -->
    <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="text-sm font-semibold text-gray-700">New Customers</div>
        <div class="w-10 h-10 bg-[#FFC220] rounded-lg flex items-center justify-center shadow">
          <%= heroicon('users', class: 'w-6 h-6 text-[#0053E2]') %>
        </div>
      </div>
      <div class="text-2xl font-semibold text-[#0053E2] mb-2">
        <%= @new_customers_this_month %>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <% if @customers_growth >= 0 %>
          <span class="text-green-600 font-bold">+<%= format_percentage(@customers_growth) %></span>
        <% else %>
          <span class="text-red-600 font-bold"><%= format_percentage(@customers_growth) %></span>
        <% end %>
        <span class="text-gray-500 font-medium">this month</span>
      </div>
    </div>
  </div>
  
  <!-- Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Recent Orders -->
    <div class="lg:col-span-2">
      <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-base font-semibold text-[#0053E2]">Recent Orders</h2>
          <%= link_to 'View All', admin_orders_path, class: 'text-sm text-[#0053E2] hover:text-[#004CC9] font-bold' %>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-[#E9F1FE] text-xs font-semibold text-[#0053E2] uppercase tracking-wider">
              <tr>
                <th class="px-6 py-3 text-left">Order</th>
                <th class="px-6 py-3 text-left">Customer</th>
                <th class="px-6 py-3 text-left">Status</th>
                <th class="px-6 py-3 text-right">Amount</th>
                <th class="px-6 py-3 text-left">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @recent_orders.each do |order| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4">
                    <%= link_to admin_order_path(order), class: 'px-3 py-1 text-sm font-medium text-[#0053E2] hover:text-[#004CC9]' do %>
                      #<%= order.id %>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-700 font-semibold">
                    <%= order.user.email %>
                  </td>
                  <td class="px-6 py-4">
                    <%= status_badge(order.status) %>
                  </td>
                  <td class="px-6 py-4 text-sm font-semibold text-[#0053E2] text-right">
                    <%= format_currency(order.total_price) %>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 font-medium">
                    <%= l(order.created_at, format: :short) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    
    <!-- Quick Stats & Alerts -->
    <div class="space-y-6">
      <!-- Pending Orders -->
      <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-700">Pending Orders</h3>
          <%= heroicon('clock', class: 'w-5 h-5 text-[#FFC220]') %>
        </div>
        <div class="text-2xl font-semibold text-[#0053E2] mb-2">
          <%= @pending_orders %>
        </div>
        <%= link_to 'View Orders', admin_orders_path(status: 'pending'), class: 'text-sm text-[#0053E2] hover:text-[#004CC9] font-bold' %>
      </div>
      
      <!-- Low Stock Alert -->
      <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-700">Low Stock Items</h3>
          <%= heroicon('exclamation', class: 'w-5 h-5 text-red-500') %>
        </div>
        <div class="text-2xl font-semibold text-[#0053E2] mb-2">
          <%= @low_stock_products %>
        </div>
        <% if @low_stock_items.any? %>
          <div class="text-sm text-gray-500 font-medium mb-3">
            <%= @out_of_stock_products %> out of stock
          </div>
          <div class="space-y-2 max-h-48 overflow-y-auto">
            <% @low_stock_items.each do |product| %>
              <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
                <div class="text-sm text-gray-700 font-semibold truncate flex-1 mr-2">
                  <%= product.name %>
                </div>
                <span class="text-sm font-semibold text-[#FFC220]">
                  Low
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-sm text-gray-500 font-medium">
            Inventory tracking coming soon
          </div>
        <% end %>
      </div>
      
      <!-- Top Products -->
      <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-700">Top Selling</h3>
          <%= heroicon('chart-bar', class: 'w-5 h-5 text-green-500') %>
        </div>
        <div class="space-y-3">
          <% @top_products.each_with_index do |product, index| %>
            <div class="flex items-center gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-[#0053E2] flex items-center justify-center text-white text-xs font-semibold shadow">
                <%= index + 1 %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold text-gray-700 truncate">
                  <%= product.name %>
                </div>
                <div class="text-xs text-gray-500 font-medium">
                  <%= product.total_sold %> sold
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
