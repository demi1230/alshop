          <script>
            (function() {
              function initializeDropdown() {
                const dropdownBtn = document.getElementById('category-dropdown-btn');
                const dropdown = document.getElementById('category-dropdown');
                const categoryLabel = document.getElementById('category-label');
                const categoryInput = document.getElementById('search-category');
                
                if (!dropdownBtn || !dropdown || !categoryLabel || !categoryInput) {
                  return; // Exit if elements not found
                }
                
                // Toggle dropdown
                dropdownBtn.onclick = function(e) {
                  e.preventDefault();
                  e.stopPropagation();
                  dropdown.classList.toggle('hidden');
                };
                
                // Close dropdown when clicking outside
                document.onclick = function(e) {
                  if (!dropdown.contains(e.target) && !dropdownBtn.contains(e.target)) {
                    dropdown.classList.add('hidden');
                  }
                };
                
                // Handle category selection - get fresh list each time
                const categoryOptions = dropdown.querySelectorAll('.category-option');
                categoryOptions.forEach(function(option) {
                  option.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const category = this.getAttribute('data-category');
                    const label = this.textContent.trim();
                    
                    categoryLabel.textContent = label;
                    categoryInput.value = category;
                    dropdown.classList.add('hidden');
                  };
                });
              }
              
              // Initialize on both events
              document.addEventListener('turbo:load', initializeDropdown);
              document.addEventListener('DOMContentLoaded', initializeDropdown);
            })();
          </script>

          <!-- User Account Link -->
          <div class="flex items-center space-x-6">
            <% if user_signed_in? %>
              <div class="relative" data-controller="dropdown">
