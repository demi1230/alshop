<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    
    <title><%= content_for(:title) || 'Admin Panel' %> | AlShop Admin</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  
  <body class="bg-gray-50 font-sans antialiased" data-controller="admin--sidebar">
    <!-- Mobile sidebar overlay -->
    <div data-admin--sidebar-target="overlay" 
         class="fixed inset-0 bg-gray-900/50 z-40 hidden lg:hidden"
         data-action="click->admin--sidebar#closeOnOverlay"></div>
    
    <!-- Sidebar -->
    <%= render 'admin/shared/sidebar' %>
    
    <!-- Main content area -->
    <div class="lg:pl-64 flex flex-col min-h-screen">
      <!-- Top bar -->
      <%= render 'admin/shared/topbar' %>
      
      <!-- Page content -->
      <main class="flex-1 p-6">
        <!-- Flash messages -->
        <% if flash.any? %>
          <div class="mb-6 space-y-3">
            <% flash.each do |type, message| %>
              <div class="rounded-lg p-4 <%= flash_class(type) %> flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <%= flash_icon(type) %>
                  <span class="font-medium"><%= message %></span>
                </div>
                <button type="button" 
                        class="text-current opacity-70 hover:opacity-100"
                        onclick="this.parentElement.remove()">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
            <% end %>
          </div>
        <% end %>
        
        <!-- Page header -->
        <% if content_for?(:page_header) %>
          <%= yield :page_header %>
        <% end %>
        
        <!-- Page content -->
        <%= yield %>
      </main>
      
      <!-- Footer -->
      <footer class="bg-white border-t border-gray-200 py-4 px-6">
        <div class="flex items-center justify-between text-sm text-[#656565]">
          <div class="font-medium">
            &copy; <%= Date.current.year %> AlShop. All rights reserved.
          </div>
          <div class="text-[#989898]">
            Version 1.0.0
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
