<%
  # Button Component
  # Usage: <%= render 'shared/button', text: 'Сагслах', variant: 'primary', icon: 'arrow', type: 'button' %>
  # Variants: primary (#0053E2), search (#003299), nav (white), hover (#001E60)
  
  variant ||= 'primary'
  type ||= 'button'
  icon ||= nil
  text ||= 'Button'
  icon_position ||= 'right' # 'left' or 'right'
  classes ||= ''
  
  base_classes = "inline-flex items-center gap-2 px-2 py-2 text-sm font-medium transition-colors"
  
  variant_classes = case variant
  when 'primary'
    "bg-[#0053E2] hover:bg-[#001E60] text-white rounded-[16px]"
  when 'search'
    "bg-[#003299] hover:bg-[#001E60] text-white rounded-[16px]"
  when 'nav'
    "bg-white hover:bg-gray-50 text-gray-700 rounded-[16px]"
  when 'cart'
    "bg-[#0053E2] hover:bg-[#001E60] text-white rounded-[16px]"
  else
    "bg-[#0053E2] hover:bg-[#001E60] text-white rounded-[16px]"
  end
  
  button_classes = "#{base_classes} #{variant_classes} #{classes}"
%>

<button type="<%= type %>" class="<%= button_classes %>">
  <% if icon && icon_position == 'left' %>
    <% if icon == 'arrow' %>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
        <path d="M8.14645 3.14645C8.34171 2.95118 8.65829 2.95118 8.85355 3.14645L12.8536 7.14645C13.0488 7.34171 13.0488 7.65829 12.8536 7.85355L8.85355 11.8536C8.65829 12.0488 8.34171 12.0488 8.14645 11.8536C7.95118 11.6583 7.95118 11.3417 8.14645 11.1464L11.2929 8H2.5C2.22386 8 2 7.77614 2 7.5C2 7.22386 2.22386 7 2.5 7H11.2929L8.14645 3.85355C7.95118 3.65829 7.95118 3.34171 8.14645 3.14645Z" fill="currentColor"/>
      </svg>
    <% elsif icon == 'plus' %>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
        <path d="M8 2.75C8 2.47386 7.77614 2.25 7.5 2.25C7.22386 2.25 7 2.47386 7 2.75V7H2.75C2.47386 7 2.25 7.22386 2.25 7.5C2.25 7.77614 2.47386 8 2.75 8H7V12.25C7 12.5261 7.22386 12.75 7.5 12.75C7.77614 12.75 8 12.5261 8 12.25V8H12.25C12.5261 8 12.75 7.77614 12.75 7.5C12.75 7.22386 12.5261 7 12.25 7H8V2.75Z" fill="currentColor"/>
      </svg>
    <% end %>
  <% end %>
  
  <span><%= text %></span>
  
  <% if icon && icon_position == 'right' %>
    <% if icon == 'arrow' %>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
        <path d="M8.14645 3.14645C8.34171 2.95118 8.65829 2.95118 8.85355 3.14645L12.8536 7.14645C13.0488 7.34171 13.0488 7.65829 12.8536 7.85355L8.85355 11.8536C8.65829 12.0488 8.34171 12.0488 8.14645 11.8536C7.95118 11.6583 7.95118 11.3417 8.14645 11.1464L11.2929 8H2.5C2.22386 8 2 7.77614 2 7.5C2 7.22386 2.22386 7 2.5 7H11.2929L8.14645 3.85355C7.95118 3.65829 7.95118 3.34171 8.14645 3.14645Z" fill="currentColor"/>
      </svg>
    <% elsif icon == 'plus' %>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
        <path d="M8 2.75C8 2.47386 7.77614 2.25 7.5 2.25C7.22386 2.25 7 2.47386 7 2.75V7H2.75C2.47386 7 2.25 7.22386 2.25 7.5C2.25 7.77614 2.47386 8 2.75 8H7V12.25C7 12.5261 7.22386 12.75 7.5 12.75C7.77614 12.75 8 12.5261 8 12.25V8H12.25C12.5261 8 12.75 7.77614 12.75 7.5C12.75 7.22386 12.5261 7 12.25 7H8V2.75Z" fill="currentColor"/>
      </svg>
    <% end %>
  <% end %>
</button>
