<%
  # Quantity Selector Component
  # Usage: <%= render 'shared/quantity_selector', quantity: 1, item_id: item.id %>
  
  quantity ||= 1
  item_id ||= nil
  size ||= 'medium' # 'small', 'medium'
  
  button_size = size == 'small' ? 'w-8 h-8' : 'w-10 h-10'
%>

<div class="flex items-center gap-3">
  <!-- Minus Button -->
  <% if item_id %>
    <%= button_to cart_item_path(item_id), method: :patch, params: { quantity: [quantity - 1, 0].max }, class: "#{button_size} rounded-full bg-[#0053E2] hover:bg-[#001E60] text-white flex items-center justify-center transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
        <path d="M2.25 7.5C2.25 7.22386 2.47386 7 2.75 7H12.25C12.5261 7 12.75 7.22386 12.75 7.5C12.75 7.77614 12.5261 8 12.25 8H2.75C2.47386 8 2.25 7.77614 2.25 7.5Z" fill="currentColor"/>
      </svg>
    <% end %>
  <% else %>
    <button type="button" class="#{button_size} rounded-full bg-[#0053E2] hover:bg-[#001E60] text-white flex items-center justify-center transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
        <path d="M2.25 7.5C2.25 7.22386 2.47386 7 2.75 7H12.25C12.5261 7 12.75 7.22386 12.75 7.5C12.75 7.77614 12.5261 8 12.25 8H2.75C2.47386 8 2.25 7.77614 2.25 7.5Z" fill="currentColor"/>
      </svg>
    </button>
  <% end %>
  
  <!-- Quantity Display -->
  <span class="<%= button_size %> rounded-full bg-white flex items-center justify-center text-sm font-semibold text-[#001E60]">
    <%= quantity %>
  </span>
  
  <!-- Plus Button -->
  <% if item_id %>
    <%= button_to cart_item_path(item_id), method: :patch, params: { quantity: quantity + 1 }, class: "#{button_size} rounded-full bg-[#0053E2] hover:bg-[#001E60] text-white flex items-center justify-center transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
        <path d="M8 2.75C8 2.47386 7.77614 2.25 7.5 2.25C7.22386 2.25 7 2.47386 7 2.75V7H2.75C2.47386 7 2.25 7.22386 2.25 7.5C2.25 7.77614 2.47386 8 2.75 8H7V12.25C7 12.5261 7.22386 12.75 7.5 12.75C7.77614 12.75 8 12.5261 8 12.25V8H12.25C12.5261 8 12.75 7.77614 12.75 7.5C12.75 7.22386 12.5261 7 12.25 7H8V2.75Z" fill="currentColor"/>
      </svg>
    <% end %>
  <% else %>
    <button type="button" class="#{button_size} rounded-full bg-[#0053E2] hover:bg-[#001E60] text-white flex items-center justify-center transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
        <path d="M8 2.75C8 2.47386 7.77614 2.25 7.5 2.25C7.22386 2.25 7 2.47386 7 2.75V7H2.75C2.47386 7 2.25 7.22386 2.25 7.5C2.25 7.77614 2.47386 8 2.75 8H7V12.25C7 12.5261 7.22386 12.75 7.5 12.75C7.77614 12.75 8 12.5261 8 12.25V8H12.25C12.5261 8 12.75 7.77614 12.75 7.5C12.75 7.22386 12.5261 7 12.25 7H8V2.75Z" fill="currentColor"/>
      </svg>
    </button>
  <% end %>
</div>
