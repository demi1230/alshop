<%
  # Cart Total Component
  # Usage: <%= render 'shared/cart_total', total: 1502400 %>
  
  total ||= 0
%>

<div class="bg-white rounded-2xl p-6 shadow-sm">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-lg font-semibold text-[#001E60]">Нийт үнэ:</h2>
    <div class="text-3xl font-black text-[#001E60]"><%= number_to_currency(total, unit: "", precision: 0) %>₮</div>
  </div>
  
  <%= link_to checkout_path, class: "w-full inline-flex items-center justify-center gap-2 px-2 py-3 text-base font-semibold bg-[#0053E2] hover:bg-[#001E60] text-white rounded-[16px] transition-colors" do %>
    <span>Төлөх</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none" class="w-[15px] h-[15px]">
