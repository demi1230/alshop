<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Хэрэглэгчийн сагс</h1>
    <p class="mt-2 text-sm text-gray-600">
      <%= link_to "← Худалдан авалт үргэлжлүүлэх", products_path, class: "text-[#0053E2] hover:text-[#003299]" %>
    </p>
  </div>

  <% if @cart&.cart_items&.any? %>
    <div class="flex gap-8">
      <!-- Cart Items -->
      <div class="flex-1">
        <div class="space-y-4">
          <% @cart.cart_items.includes(sellable_variant: :sellable).each do |item| %>
            <div class="bg-[#E9F1FE] rounded-lg p-6">
              <div class="flex gap-6">
                <!-- Product Image -->
                <div class="flex-shrink-0 w-32 h-32 bg-white rounded-lg p-4 relative">
                  <% product = Product.find_by(sellable: item.sellable_variant.sellable) %>
                  <% if product&.brand %>
                    <div class="absolute top-2 left-2 bg-black rounded px-2 py-1">
                      <span class="text-white text-xs font-semibold"><%= product.brand.name %></span>
                    </div>
                  <% end %>
                  
                  <% if discount = calculate_discount(item.sellable_variant.sellable) %>
                    <div class="absolute top-2 right-2 bg-yellow-300 rounded-full px-2 py-1">
                      <span class="text-xs font-bold">-<%= discount %>%</span>
                    </div>
                  <% end %>
                  
                  <svg class="w-full h-full object-contain" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="400" height="400" fill="#E5E7EB"/>
                    <path d="M200 140C185.087 140 172.5 152.587 172.5 167.5C172.5 182.413 185.087 195 200 195C214.913 195 227.5 182.413 227.5 167.5C227.5 152.587 214.913 140 200 140Z" fill="#9CA3AF"/>
                    <path d="M150 220L175 195L200 220L250 170L260 180V260H140V220H150Z" fill="#9CA3AF"/>
                  </svg>
                </div>

                <!-- Product Info -->
                <div class="flex-1">
                  <h3 class="font-bold text-gray-900 mb-2">
                    <%= item.sellable_variant.sellable.name %>
                  </h3>
                  
                  <% if item.sellable_variant.variant_name.present? %>
                    <p class="text-sm text-gray-600 mb-2">
                      Хувилбар: <%= item.sellable_variant.variant_name %>
                    </p>
                  <% end %>
                  
                  <!-- Price -->
                  <div class="mb-4">
                    <% variant_price = item.sellable_variant&.discounted_price || item.sellable.base_price %>
                    <% original_price = item.sellable_variant&.effective_price || item.sellable.base_price %>
                    <% has_discount = item.sellable_variant&.has_discount? || false %>
                    
                    <div class="flex items-center gap-2">
                      <span class="text-lg font-bold text-gray-900">
                        <%= number_to_currency(variant_price, unit: "₮", precision: 0, format: "%n%u") %>
                      </span>
                      <% if has_discount %>
                        <span class="text-sm text-gray-400 line-through">
                          <%= number_to_currency(original_price, unit: "₮", precision: 0, format: "%n%u") %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                  
                  <!-- Stock Info -->
                  <% current_stock = item.sellable_variant&.inventory&.quantity || 0 %>
                  <% if current_stock <= 5 %>
                    <div class="mb-2">
                      <span class="text-xs <%= current_stock == 0 ? 'text-red-600' : 'text-orange-600' %> font-semibold">
                        <%= current_stock == 0 ? 'Дууссан' : "#{current_stock} ширхэг үлдсэн" %>
                      </span>
                    </div>
                  <% end %>

                  <!-- Quantity Controls -->
                  <div class="flex items-center gap-4">
                    <%= form_with url: cart_item_path(item), method: :patch, data: { turbo: false }, class: "flex items-center gap-3" do |f| %>
                      <% decrease_disabled = item.quantity <= 1 %>
                      <%= button_tag type: "submit", 
                        name: "cart_item[quantity]", 
                        value: [item.quantity - 1, 1].max,
                        disabled: decrease_disabled,
                        class: "w-10 h-10 rounded-full flex items-center justify-center transition-all #{decrease_disabled ? 'bg-gray-500 cursor-not-allowed opacity-50' : 'bg-[#0053E2] hover:bg-[#003299]'}" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M13.5 6.5C13.7761 6.5 14 6.72386 14 7C14 7.27614 13.7761 7.5 13.5 7.5H0.5C0.223858 7.5 0 7.27614 0 7C0 6.72386 0.223858 6.5 0.5 6.5H13.5Z" fill="white"/>
                        </svg>
                      <% end %>
                      
                      <span class="text-2xl font-bold text-gray-900 w-12 text-center">
                        <%= item.quantity %>
                      </span>
                      
                      <% increase_disabled = item.quantity >= current_stock %>
                      <%= button_tag type: "submit", 
                        name: "cart_item[quantity]", 
                        value: item.quantity + 1,
                        disabled: increase_disabled,
                        class: "w-10 h-10 rounded-full flex items-center justify-center transition-all #{increase_disabled ? 'bg-gray-500 cursor-not-allowed opacity-50' : 'bg-[#0053E2] hover:bg-[#003299]'}" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                          <path d="M7.5 0C7.79587 0 8.03571 0.239847 8.03571 0.535714V6.96429H14.4643C14.7602 6.96429 15 7.20413 15 7.5C14.9999 7.79578 14.7601 8.03571 14.4643 8.03571H8.03571V14.4643C8.03557 14.76 7.79578 15 7.5 15C7.20422 15 6.96443 14.76 6.96429 14.4643V8.03571H0.535714C0.239913 8.03571 0.000105998 7.79578 0 7.5C0 7.20413 0.239847 6.96429 0.535714 6.96429H6.96429V0.535714C6.96429 0.239847 7.20413 0 7.5 0Z" fill="#E9F1FE"/>
                        </svg>
                      <% end %>
                    <% end %>
                  </div>
                </div>

                <!-- Remove Button -->
                <div class="flex-shrink-0">
                  <%= button_to cart_item_path(item), 
                    method: :delete,
                    form: { data: { turbo: false } },
                    class: "w-10 h-10 bg-red-500 hover:bg-red-600 rounded-full flex items-center justify-center transition-colors" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" viewBox="0 0 14 15" fill="none">
                      <path d="M0.201157 0.215525C0.469365 -0.0718416 0.904218 -0.0718416 1.17243 0.215525L7.00004 6.4594L12.8277 0.215525C13.0959 -0.0718416 13.5307 -0.0718416 13.7989 0.215525C14.067 0.502907 14.0671 0.968868 13.7989 1.25617L7.97131 7.50005L13.7989 13.7439C14.0669 14.0313 14.0671 14.4973 13.7989 14.7846C13.5308 15.0719 13.0959 15.0717 12.8277 14.7846L7.00004 8.54069L1.17243 14.7846C0.904277 15.0719 0.46938 15.0717 0.201157 14.7846C-0.0670522 14.4972 -0.0670522 14.0313 0.201157 13.7439L6.02877 7.50005L0.201157 1.25617C-0.0670522 0.968805 -0.0670522 0.502891 0.201157 0.215525Z" fill="#E9F1FE"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Clear Cart Button -->
        <div class="mt-6">
          <%= button_to "Сагс хоослох", 
            clear_cart_path, 
            method: :delete,
            form: { data: { turbo: false, confirm: "Та сагсыг хоослохдоо итгэлтэй байна уу?" } },
            class: "text-red-600 hover:text-red-700 font-semibold text-sm" %>
        </div>
      </div>

      <!-- Cart Summary -->
      <aside class="flex-shrink-0 w-96">
        <div class="bg-white rounded-lg shadow-sm p-6 sticky top-4">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Төлбөрийн мэдээлэл</h2>
          
          <!-- Cart Items List -->
          <div class="space-y-4 mb-6 pb-6 border-b border-gray-200">
            <% @cart.cart_items.each do |item| %>
              <div class="flex justify-between text-sm">
                <span class="text-gray-700">
                  <%= item.sellable_variant.sellable.name %> × <%= item.quantity %>
                </span>
                <span class="font-semibold text-gray-900">
                  <%= number_to_currency((item.sellable_variant&.discounted_price || item.sellable.base_price) * item.quantity, unit: "₮", precision: 0, format: "%n%u") %>
                </span>
              </div>
            <% end %>
          </div>

          <!-- Total -->
          <div class="flex justify-between items-center mb-8">
            <span class="text-lg font-semibold text-gray-900">Нийт үнэ:</span>
            <span class="text-3xl font-bold text-gray-900">
              <%= number_to_currency(
                @cart.cart_items.sum { |item| (item.sellable_variant&.discounted_price || item.sellable.base_price) * item.quantity },
                unit: "₮", 
                precision: 0, 
                format: "%n%u"
              ) %>
            </span>
          </div>

          <!-- Checkout Button -->
          <% if user_signed_in? %>
            <%= link_to orders_path(cart_id: @cart.id), 
              method: :post,
              data: { turbo_method: :post },
              class: "w-full bg-[#0053E2] hover:bg-[#003299] active:bg-[#001E60] text-white text-lg font-bold py-4 px-6 rounded-button flex items-center justify-center gap-2 transition-colors" do %>
              <span>Төлөх</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                <path d="M8.13961 0.158998C8.3267 -0.0530697 8.63019 -0.0529289 8.81735 0.158998L14.8574 7.00374C15.0506 7.22315 15.047 7.58094 14.8495 7.79561C14.8133 7.83497 14.7721 7.86457 14.7294 7.88877L8.99703 14.8331C8.81334 15.0556 8.51564 15.0557 8.332 14.8331C8.14873 14.6105 8.14848 14.2495 8.332 14.027L13.3486 7.94959H0.499998C0.223918 7.94959 9.89309e-05 7.65287 0 7.28711C0 6.92123 0.223857 6.62463 0.499998 6.62463H13.1445L8.13961 0.926282C7.95347 0.714225 7.95339 0.370823 8.13961 0.158998Z" fill="#E9F1FE"/>
              </svg>
            <% end %>
          <% else %>
            <%= link_to new_user_session_path, 
              class: "w-full bg-[#0053E2] hover:bg-[#003299] text-white text-lg font-bold py-4 px-6 rounded-button text-center block transition-colors" do %>
              Нэвтрэх
            <% end %>
            <p class="mt-3 text-sm text-gray-600 text-center">
              Худалдан авалт хийхийн тулд нэвтэрнэ үү
            </p>
          <% end %>
        </div>
      </aside>
    </div>
  <% else %>
    <!-- Empty Cart -->
    <div class="bg-white rounded-lg shadow-sm text-center py-16">
      <svg class="mx-auto h-24 w-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
      </svg>
      <h2 class="mt-6 text-2xl font-bold text-gray-900">Таны сагс хоосон байна</h2>
      <p class="mt-2 text-gray-600">Бүтээгдэхүүн сонгож сагслана уу</p>
      <%= link_to "Бүтээгдэхүүн үзэх", products_path, 
        class: "mt-8 inline-block bg-[#0053E2] hover:bg-[#003299] text-white font-bold py-3 px-8 rounded-button transition-colors" %>
    </div>
  <% end %>
</div>
